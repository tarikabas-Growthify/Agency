---
// Projets présentés en cartes empilées : chaque carte reste collée en haut
// pendant que la suivante arrive par-dessus.
import type { CollectionEntry } from 'astro:content';
import BrowserFrame from './BrowserFrame.astro';
import Icon from './Icon.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<div class="stack" data-stack>
  {
    projects.map((p, i) => (
      <div class="stack-item" data-stack-item style={`--i: ${i}`}>
        <article class="project card" data-screen-host>
          <div class="project-info">
            <div class="project-top">
              <span class="project-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="chip">{p.data.industry}</span>
            </div>
            <h3 class="display-3">
              <a href={`/projects/${p.id}`} class="project-link">
                {p.data.title}
              </a>
            </h3>
            <p class="muted">{p.data.summary}</p>
            <ul class="project-stack">
              {p.data.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <span class="link-arrow">
              Voir l'étude de cas <Icon name="arrow" size={18} />
            </span>
          </div>
          <div class="project-visual" data-cursor-text="Voir">
            <BrowserFrame src={p.data.screenshot} alt={p.data.screenshotAlt} url={p.data.client.toLowerCase().replace(/[^a-z]/g, '') + '.fr'} height="clamp(300px, 38vw, 470px)" />
          </div>
        </article>
      </div>
    ))
  }
</div>

<style>
  .stack {
    display: grid;
    gap: 2rem;
  }
  .stack-item {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem + var(--i) * 1.2rem);
  }
  .project {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(1.4rem, 3.5vw, 3rem);
    background: linear-gradient(150deg, var(--ink-800), var(--ink-900));
    transform-origin: 50% 0;
    will-change: transform;
  }
  .project-info {
    display: grid;
    gap: 1.3rem;
    align-content: center;
  }
  .project-top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .project-num {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--violet-300);
  }
  .project-link::after {
    /* toute la carte est cliquable */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project-stack li {
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.05);
    color: var(--text-soft);
  }
  @media (max-width: 900px) {
    .project {
      grid-template-columns: 1fr;
    }
    .project-visual {
      order: -1;
    }
    .stack-item {
      position: relative;
      top: 0;
    }
  }
</style>
