---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
  <a href={`/blog-post/${post.id}`} class="post-link" data-cursor-text="Lire">
    <div class="post-media">
      <Image src={post.data.cover} alt={post.data.coverAlt} widths={[480, 800, 1200]} sizes={featured ? '(max-width: 900px) 92vw, 60vw' : '(max-width: 900px) 92vw, 400px'} />
    </div>
    <div class="post-body">
      <div class="post-meta">
        <span class="chip">{post.data.category}</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>· {readingTime(post.body ?? '')} min</span>
      </div>
      <h3>{post.data.title}</h3>
      {featured && <p class="muted">{post.data.description}</p>}
      <span class="link-arrow">Lire l'article <Icon name="arrow" size={18} /></span>
    </div>
  </a>
</article>

<style>
  .post-link {
    display: grid;
    gap: 1.4rem;
    height: 100%;
  }
  .post-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
  }
  .post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease), filter 0.6s;
  }
  .post-link:hover .post-media img {
    transform: scale(1.06);
  }
  .post-body {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .post-body h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .post-link:hover h3 {
    color: var(--violet-300);
  }
  .post-card--featured .post-link {
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .post-card--featured h3 {
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
  }
  @media (max-width: 900px) {
    .post-card--featured .post-link {
      grid-template-columns: 1fr;
    }
  }
</style>
