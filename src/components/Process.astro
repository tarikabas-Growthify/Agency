---
// Étapes de travail reliées par une ligne qui se dessine au défilement.
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
  eyebrow?: string;
  title?: string;
}
const { steps, eyebrow = 'Notre méthode', title = 'Comment nous transformons votre besoin en résultats.' } = Astro.props;
---

<section class="section process" data-draw-scope>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 class="display-2" data-split="words">{title}</h2>
    </div>
    <ol class="steps">
      <svg class="steps-line" viewBox="0 0 4 1000" preserveAspectRatio="none" aria-hidden="true">
        <path d="M2 0 V1000" stroke="url(#steps-grad)" stroke-width="2" fill="none" data-draw vector-effect="non-scaling-stroke"></path>
        <defs>
          <linearGradient id="steps-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ff4d9a"></stop>
            <stop offset="1" stop-color="#6d4cfa"></stop>
          </linearGradient>
        </defs>
      </svg>
      {
        steps.map((s, i) => (
          <li class="step" data-reveal>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 900px;
    margin-left: auto;
  }
  .steps-line {
    position: absolute;
    left: 31px;
    top: 10px;
    bottom: 10px;
    width: 4px;
    height: calc(100% - 20px);
    overflow: visible;
  }
  .steps::before {
    content: '';
    position: absolute;
    left: 32px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--line);
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 66px 1fr;
    gap: clamp(1.2rem, 3vw, 2.5rem);
  }
  .step-num {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: var(--ink-900);
    border: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--violet-300);
  }
  .step h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    margin: 0.9rem 0 0.8rem;
  }
  .step p {
    max-width: 58ch;
  }
</style>
