---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---

<section class="section testimonials">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow" data-reveal>Avis clients</p>
      <h2 class="display-2" data-split="words">L'impact de nos réalisations sur leur business.</h2>
    </div>

    <div class="slider card" data-slider data-reveal>
      <Icon name="quote" size={64} class="quote-mark" />
      <div class="slides">
        {
          testimonials.map((t) => (
            <figure class="slide" data-slide>
              <blockquote>
                <p>« {t.quote} »</p>
              </blockquote>
              <figcaption data-slide-anim>
                {t.photo ? (
                  <Image src={t.photo} alt="" width={56} height={56} class="avatar" />
                ) : (
                  <span class="avatar avatar--initials" aria-hidden="true">
                    {t.name
                      .split(' ')
                      .map((p) => p[0])
                      .join('')}
                  </span>
                )}
                <span>
                  <strong>{t.name}</strong>
                  <small>{t.role}</small>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="slider-foot">
        <div class="slider-dots">
          {testimonials.map((t, i) => <button type="button" data-slide-dot aria-label={`Témoignage de ${t.name}`} aria-current={i === 0 ? 'true' : 'false'} />)}
        </div>
        <div class="slider-bar"><span data-slide-bar></span></div>
        <div class="slider-arrows">
          <button type="button" data-slide-prev aria-label="Témoignage précédent"><Icon name="arrow" class="flip" /></button>
          <button type="button" data-slide-next aria-label="Témoignage suivant"><Icon name="arrow" /></button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .slider {
    max-width: 1000px;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 4.5rem);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015));
  }
  .slider :global(.quote-mark) {
    color: var(--violet-400);
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }
  .slides {
    display: grid;
  }
  .slide {
    grid-area: 1 / 1;
    margin: 0;
  }
  .slide:not(:first-child) {
    opacity: 0;
  }
  .slide[aria-hidden='true'] {
    pointer-events: none;
  }
  .slide blockquote {
    margin: 0;
  }
  .slide blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .slide figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.2rem;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--line-strong);
  }
  .avatar--initials {
    display: grid;
    place-items: center;
    background: var(--gradient);
    font-weight: 600;
  }
  .slide strong {
    display: block;
  }
  .slide small {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .slider-foot {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .slider-dots {
    display: flex;
    gap: 0.5rem;
  }
  .slider-dots button {
    width: 10px;
    height: 10px;
    padding: 0;
    border-radius: 50%;
    border: 0;
    background: var(--line-strong);
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
  }
  .slider-dots button[aria-current='true'] {
    background: var(--violet-400);
    transform: scale(1.3);
  }
  .slider-bar {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }
  .slider-bar span {
    display: block;
    height: 100%;
    background: var(--gradient);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .slider-arrows {
    display: flex;
    gap: 0.5rem;
  }
  .slider-arrows button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    cursor: pointer;
    transition: background 0.3s, border-color 0.3s;
  }
  .slider-arrows button:hover {
    background: var(--violet-500);
    border-color: var(--violet-500);
  }
  .slider-arrows :global(.flip) {
    transform: rotate(180deg);
  }
</style>
