---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="header-logo" aria-label="Growthify, retour à l'accueil">
      <Logo />
    </a>

    <nav class="header-nav" aria-label="Navigation principale">
      <ul>
        {
          nav.map((item) =>
            item.href === '/services' ? (
              <li class="has-mega">
                <a href={item.href} class:list={{ active: isActive(item.href) }} data-magnetic="0.25">
                  {item.label}
                </a>
                <div class="mega">
                  <div class="mega-inner">
                    {services.map((s) => (
                      <a href={`/services/${s.id}`} class="mega-link">
                        <span class="mega-icon">
                          <Icon name={s.data.icon} size={20} />
                        </span>
                        <span>
                          <strong>{s.data.title}</strong>
                          <small>{s.data.short}</small>
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={{ active: isActive(item.href) }} data-magnetic="0.25">
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={site.osUrl} class="header-login" rel="nofollow">Connexion</a>
      <a href={site.calendly} class="btn btn--gradient btn--sm" target="_blank" rel="noopener" data-magnetic>
        Prendre RDV
      </a>
      <button class="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" data-menu aria-hidden="true">
  <div class="mobile-menu-bg"></div>
  <nav class="container mobile-menu-inner" aria-label="Navigation mobile">
    <ul>
      <li><a href="/" data-menu-link>Accueil</a></li>
      {nav.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
    </ul>
    <div class="mobile-menu-foot" data-menu-link>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.calendly} class="btn btn--gradient" target="_blank" rel="noopener">Prendre RDV</a>
      <a href={site.osUrl} class="header-login" rel="nofollow">Connexion</a>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    height: var(--header-h);
    display: flex;
    align-items: center;
    transition: background 0.5s var(--ease), border-color 0.5s, transform 0.6s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: rgb(7 10 31 / 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-color: var(--line);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .header-logo {
    font-size: 1.05rem;
    position: relative;
    z-index: 2;
  }
  .header-nav ul {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.03);
  }
  .header-nav a {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    color: var(--text-soft);
    transition: color 0.3s, background 0.3s;
  }
  .header-nav a:hover,
  .header-nav a.active {
    color: var(--text);
    background: rgb(255 255 255 / 0.07);
  }
  .has-mega {
    position: relative;
  }
  .mega {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 50%;
    width: min(760px, 90vw);
    transform: translate(-50%, 10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease), visibility 0.35s;
  }
  .mega::before {
    content: '';
    position: absolute;
    inset: -1rem 0 auto;
    height: 1rem;
  }
  .has-mega:hover .mega,
  .has-mega:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .mega-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    padding: 0.6rem;
    border-radius: var(--radius);
    background: rgb(16 23 59 / 0.96);
    border: 1px solid var(--line-strong);
    backdrop-filter: blur(20px);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }
  .header-nav .mega-link {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    white-space: normal;
  }
  .mega-link strong {
    display: block;
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .mega-link small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.4;
    margin-top: 0.2rem;
  }
  .mega-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 12px;
    background: var(--gradient-soft);
    border: 1px solid var(--line-strong);
    color: var(--violet-300);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    position: relative;
    z-index: 2;
  }
  .header-login {
    font-size: 0.85rem;
    color: var(--muted);
    transition: color 0.3s;
  }
  .header-login:hover {
    color: var(--text);
  }
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.04);
    cursor: pointer;
    position: relative;
  }
  .burger span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.6px;
    background: var(--text);
    transition: transform 0.5s var(--ease);
  }
  .burger span:first-child {
    top: 19px;
  }
  .burger span:last-child {
    top: 26px;
  }
  :global(html.menu-open) .burger span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  :global(html.menu-open) .burger span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 70;
    visibility: hidden;
  }
  .mobile-menu-bg {
    position: absolute;
    inset: 0;
    background: var(--ink-900);
    clip-path: circle(0% at calc(100% - 3rem) 2.4rem);
  }
  .mobile-menu-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
    padding-block: calc(var(--header-h) + 2rem) 2rem;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu li a {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 10vw, 3.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .mobile-menu-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    margin-top: 2.5rem;
    color: var(--text-soft);
  }

  @media (max-width: 1040px) {
    .header-nav,
    .header-actions > .header-login,
    .header-actions > .btn {
      display: none;
    }
    .burger {
      display: block;
    }
  }
</style>
