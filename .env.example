# Clé publique Turnstile (visible dans le navigateur) : à définir dans Cloudflare Pages
# > Settings > Variables and Secrets, pour la construction du site.
PUBLIC_TURNSTILE_SITE_KEY=

# Secrets (à définir dans Cloudflare Pages > Settings > Variables and Secrets, type « Secret ») :
# BREVO_API_KEY=
# TURNSTILE_SECRET_KEY=
# Optionnels :
# CONTACT_TO=tarik.abas@growthify.fr
# BREVO_SENDER_EMAIL=contact@growthify.fr
# BREVO_LIST_ID=
